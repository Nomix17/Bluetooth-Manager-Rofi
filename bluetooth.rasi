/* Personal rofi theme, you can change it if you want */

* {
    font: "JetBrainsMono Nerd Font 10";
    nord13: #c9a978;

    background-color: transparent;
    text-color: #ffffff;

    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    background-color: #040507;
    border-color: #1f242d;
    anchor: center;
    location: center;
    width: 450px;
    border: 2px;
    border-radius: 10px;
}

mainbox {
    children: [message, inputbar, listview];
}

message {
    padding: 6px 12px;
    border-color: #1f242d;
    border: 0px 0px 1px 0px;
}

textbox {
    text-color: #434343;
    font: "JetBrainsMono Nerd Font 9";
}

inputbar {
    padding: 8px 12px;
    spacing: 12px;
    children: [prompt, entry];
    border-color: #1f242d;
    border: 0px 0px 1px 0px;
}

prompt, entry, element-text, element-icon {
    vertical-align: 0.5;
}

prompt {
    text-color: #434343;
}

listview {
    lines: 8;
    columns: 1;
    fixed-height: false;
}

element {
    padding: 8px;
    spacing: 8px;
}

element normal urgent {
    text-color: @nord13;
}

element normal active {
    text-color: #ffffff;
}

element selected {
    text-color: #ffffff;
}

element selected normal,
element selected urgent,
element selected active {
    background-color: #14161B;
}

element-icon {
    size: 1.75em;
}

element-text {
    text-color: inherit;
}
